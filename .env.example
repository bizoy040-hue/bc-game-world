# Copy to .env for local use. On Render, set these in Environment (never commit real values).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password
# 32+ random characters
JWT_SECRET=
NODE_ENV=production
# Neon: copy the full "Connection string" from the Neon dashboard (starts with postgresql://, host ends in neon.tech)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
